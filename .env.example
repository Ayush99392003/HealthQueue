# ============================================================
# Environment Variables — Healthcare Appointment Manager
# Copy this file to .env and fill in all values.
# ⚠️ NEVER commit .env to git — it is listed in .gitignore
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_NAME="Healthcare Appointment & Follow-up Manager"
APP_VERSION="0.1.0"
ENVIRONMENT=development          # development | staging | production
DEBUG=false

# ── Database (PostgreSQL on Railway) ─────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/healthcare_db

# ── JWT Security ─────────────────────────────────────────────
JWT_SECRET_KEY=your-very-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM Providers ─────────────────────────────────────────────
DEFAULT_LLM_PROVIDER=groq        # groq | openai | anthropic | gemini | azure

GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# ── LLM Retry Config ──────────────────────────────────────────
LLM_TIMEOUT_SECONDS=5
LLM_MAX_RETRIES=2

# ── Twilio WhatsApp ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Email (SMTP / SendGrid) ───────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=SG.your_sendgrid_key
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME="Healthcare Manager"

# ── Google Calendar OAuth 2.0 ─────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/calendar/callback
# Fernet key for encrypting stored OAuth tokens (generate: Fernet.generate_key())
GOOGLE_OAUTH_ENCRYPTION_KEY=

# ── Queue Engine ──────────────────────────────────────────────
DELAY_DETECTION_THRESHOLD_MINUTES=20
ANCHOR_SLOT_GRACE_WINDOW_MINUTES=10
PRIORITY_SERVE_RATIO=4           # Serve 1 priority patient every N regular patients
