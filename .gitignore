.uv/
uv.lock

# ── Environment Variables (NEVER COMMIT) ─────────────────────
.env
.env.local
.env.staging
.env.production
*.env

# ── IDE / Editor ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Testing & Coverage ────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.hypothesis/

